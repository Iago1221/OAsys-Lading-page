# Bloqueia acesso direto a qualquer arquivo desta pasta pelo navegador
# (os dados só devem ser lidos pelo leads.php, via sistema de arquivos).
# Funciona em Apache. Se o servidor for Nginx, peça pra quem administra
# o hosting adicionar um "location /leads/ { deny all; }" equivalente.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
